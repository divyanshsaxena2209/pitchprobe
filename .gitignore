# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python-generated files and local training outputs
__pycache__/
*.py[cod]
.pytest_cache/
training/artifacts/
training/data/claims.csv
training/data/private/

# Generated public-dataset mapping; recreate locally from source
training/data/external_claims*.csv
# Human annotation sheets and local question-bank review data
training/data/manual_risk_review*.csv
training/data/question_bank*.csv
